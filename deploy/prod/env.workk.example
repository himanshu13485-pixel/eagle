# Eagle production env for workk.work.
# Copy to the repo root as `.env.workk`, fill the secrets, keep it out of git.
#   cp deploy/prod/env.workk.example .env.workk
# Generate each secret with:  openssl rand -base64 36

# ---- Database ----
POSTGRES_PASSWORD=

# ---- Secrets (rotating these logs everyone out / invalidates device tokens) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
DEVICE_TOKEN_SECRET=

# ---- Public URLs ----
# Single domain: the dashboard and API are same-origin, so there is no CORS.
# AGENT_PUBLIC_URL is baked into every agent installer — changing it after
# devices are enrolled means reinstalling the agent on each one.
PUBLIC_API_URL=https://workk.work
AGENT_PUBLIC_URL=https://workk.work
DASHBOARD_URL=https://workk.work/app

# ---- Host ports (127.0.0.1 only; nginx proxies to these) ----
# Defaults avoid 3000/4000/8080 which other projects on this server already use.
# Confirm they're free:  ss -ltnp | grep -E '4100|8180|8181'
API_HOST_PORT=4100
DASHBOARD_HOST_PORT=8180
WEB_HOST_PORT=8181

# ---- Optional integrations (DRY mode until set) ----
# Where the public contact form sends enquiries. Without SMTP_HOST *and* this,
# enquiries are only written to the API log.
# CONTACT_TO=sales@workk.work
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Eagle <no-reply@workk.work>"
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=sandbox
# CASHFREE_CURRENCY=INR
