# ---- Database ----
# Local dev (zero-infra): SQLite file. Production: swap to Postgres, e.g.
#   DATABASE_URL="postgresql://eagle:eagle@localhost:5432/eagle?schema=public"
DATABASE_URL="file:./dev.db"

# ---- Redis (BullMQ, presence) ----
REDIS_URL="redis://localhost:6379"

# ---- Object storage (MinIO / S3-compatible) ----
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="eagle"
S3_SECRET_KEY="eagle-secret"
S3_BUCKET="eagle-screenshots"
S3_FORCE_PATH_STYLE="true"

# ---- API ----
API_PORT=4000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
DEVICE_TOKEN_SECRET="change-me-device"

# ---- Web / Dashboard (Vite) ----
VITE_API_URL="http://localhost:4000"
