# ---- Database ----
# Local dev (zero-infra): SQLite file. Production: swap to Postgres, e.g.
#   DATABASE_URL="postgresql://eagle:eagle@localhost:5432/eagle?schema=public"
DATABASE_URL="file:./dev.db"

# ---- Redis (BullMQ, presence) ----
REDIS_URL="redis://localhost:6379"

# ---- Object storage (MinIO / S3-compatible) ----
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="eagle"
S3_SECRET_KEY="eagle-secret"
S3_BUCKET="eagle-screenshots"
S3_FORCE_PATH_STYLE="true"

# ---- API ----
API_PORT=4000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Super Admin (platform) session + "act as client" impersonation token lifetimes.
JWT_ADMIN_TTL="1d"
JWT_IMPERSONATE_TTL="8h"
DEVICE_TOKEN_SECRET="change-me-device"

# Origin used to build user-facing links (e.g. the password-reset email link).
DASHBOARD_URL="http://localhost:5173"
# Public base URL of the API, baked into generated agent installers so devices can reach it.
AGENT_PUBLIC_URL="http://localhost:4000"

# ---- Email (SMTP) ----
# Leave unset to run mail in DRY mode (logged, not sent). Set SMTP_HOST to enable.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="EagleSee <no-reply@eaglesee.local>"

# Where enquiries from the public contact form are emailed (comma-separated).
# Falls back to SMTP_USER. With neither set, enquiries are logged, not emailed.
# CONTACT_TO="sales@workk.work"

# ---- Notification channels (WhatsApp / Telegram) ----
# Each runs in DRY mode (logged, not delivered) until its credentials are set.
# Telegram Bot API token (from @BotFather):
# TELEGRAM_BOT_TOKEN=""
# WhatsApp Cloud API (Meta) token + phone number id:
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""

# ---- Billing (Cashfree) ----
# Leave unset to run checkout in DRY mode (simulated payments, no gateway).
# CASHFREE_APP_ID=""
# CASHFREE_SECRET_KEY=""
# CASHFREE_ENV="sandbox"   # sandbox | production
# CASHFREE_CURRENCY="INR"

# ---- Web / Dashboard (Vite) ----
VITE_API_URL="http://localhost:4000"
