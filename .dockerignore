# Keep the build context small and hermetic. Without this, a stray npm install
# on the server would copy host node_modules into the image — Linux images
# built from a Windows or macOS checkout then fail on native binaries.
node_modules
**/node_modules
dist
**/dist
.git
.github
*.log
.env
.env.*
!.env.example
apps/agent/dist-bin
apps/api/storage
# Runtime data bind-mounted into the containers (Postgres, screenshots, and the
# ~90MB agent binary). It lives under the repo root on the server, so without
# this every build ships it to the daemon as build context.
data
**/*.db
**/*.tsbuildinfo
